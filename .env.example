NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lgrp
MYSQL_USER=lgrp_app
MYSQL_PASSWORD=replace-with-a-private-password
MYSQL_CONNECTION_LIMIT=10

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Used only by scripts/create-admin.mjs; provide them temporarily in the shell.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by scripts/migrate-supabase-to-mysql.mjs; never commit these values.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=